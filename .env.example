# SENTINEL AI Mule Detection & Fraud Intelligence Platform
# Environment Configuration Template

# Server Configuration
SENTINEL_PORT=8000
SENTINEL_HOST=0.0.0.0

# Authentication & Session Security
JWT_SECRET=sentinel-enterprise-cyber-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LLM Copilot Configuration
# Provider options: "gemini" | "openai" | "anthropic" | "local_grounded"
# If no API key is provided, SENTINEL operates in high-precision Local Grounded Forensic Engine mode.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL_NAME=gemini-1.5-flash
